# Copy to .env.local (dev) or pass as container env (prod).

APP_NAME=ChessLab
# Local: http://localhost:3000
# Live:  https://plywise.erevolutionsindia.com
APP_URL=https://plywise.erevolutionsindia.com

# Required in production. `openssl rand -hex 32`
AUTH_SECRET=

# MySQL / Prisma — copy to .env.local and fill in (never commit the real URL)
DATABASE_URL=
MYSQL_URL=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# SMTP (Gmail: smtp.gmail.com, port 587, use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=ChessLab

# How long the signup OTP stays valid
OTP_MINUTES=10
